/* Sizes target the 1080x1920 reference: 1 panel px ~ 1 phone px, i.e. 2D CSS px x3. Layout mirrors the 2D sandbox.css:
   desktop values by default, the "narrow" class (portrait, set by HudController) carries the max-width: 640px values.
   Pointer picking is not a USS property in Unity 6: HudController sets
   PickingMode.Ignore on everything except buttons and overlays so touch reaches steering. */
* {
    color: rgb(255, 255, 255);
    font-size: 42px;
    white-space: normal;
}

#hud {
    position: absolute;
    top: 36px; left: 36px; right: 36px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.row { flex-direction: row; flex-wrap: nowrap; }
.row > Label { white-space: nowrap; }
.big { font-size: 54px; -unity-font-style: bold; }
.dim, .dim > Label { color: rgba(255, 255, 255, 0.7); }

.panel {
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 30px;
    padding: 24px 36px;
}

#hud-left { flex-direction: column; align-items: flex-start; }
#hud-right { flex-direction: column; align-items: flex-end; }
#hud-left > *, #hud-right > * { margin-bottom: 24px; }
#timePanel, #scorePanel { width: 468px; }
#scorePanel Label { -unity-text-align: middle-right; }
#scorePanel .row { justify-content: flex-end; }
#mini {
    width: 468px; height: 402px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 30px;
}
#controls {
    position: absolute; left: 50%; top: 36px; translate: -50% 0;
    flex-direction: row; align-items: center;
}
#lapCounter { font-size: 78px; padding-right: 6px; }
#lapCounter > Label { font-size: 78px; -unity-font-style: bold; }

#combo { position: absolute; left: 0; right: 0; top: 192px; -unity-text-align: middle-center; font-size: 84px; -unity-font-style: bold; color: rgb(255, 211, 77); opacity: 0; }
#flash { position: absolute; left: 0; right: 0; top: 330px; -unity-text-align: middle-center; font-size: 66px; -unity-font-style: bold; opacity: 0; }
#count { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-text-align: middle-center; font-size: 312px; -unity-font-style: bold; opacity: 0; }
#hint {
    position: absolute; left: 0; right: 0; bottom: 42px;
    -unity-text-align: middle-center;
    font-size: 39px;
    opacity: 0.55;
}

.btn {
    background-color: rgba(10, 12, 16, 0.7);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 12px;
    padding: 12px 22px;
    font-size: 30px;
}
.btn:hover { background-color: rgba(60, 64, 74, 0.85); }
.btn.wide { min-width: 460px; margin-top: 14px; }
#menuBtn {
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 30px;
    padding: 24px 36px;
    font-size: 42px;
}
#pauseBtn {
    position: absolute; left: 50%; top: 30%; translate: -50% 0;
    width: 138px; height: 114px;
    margin: 0; padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 30px;
    font-size: 54px;
}

/* Portrait: the max-width: 640px block of sandbox.css. */
.narrow #timePanel, .narrow #scorePanel { width: 360px; padding: 18px 27px; }
.narrow #mini { width: 360px; height: 309px; }
.narrow #controls { flex-direction: column; align-items: stretch; }
.narrow #pauseBtn { top: 450px; }

.overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.62);
}
.card {
    align-items: center;
    background-color: rgba(18, 20, 26, 0.92);
    border-radius: 16px;
    padding: 24px 32px;
    max-width: 94%;
}
.ov-title { font-size: 64px; -unity-font-style: bold; -unity-text-align: middle-center; }
.ov-sub { font-size: 30px; color: rgb(184, 188, 196); margin-top: 8px; }

#rr-score, #rr-tires, #rr-achievements, #rr-laps { align-items: center; margin-top: 10px; }
.rr-label { color: rgb(184, 188, 196); }
.rr-pps { font-size: 48px; -unity-font-style: bold; }
.rr-badge { color: rgb(255, 214, 90); -unity-font-style: bold; }
.rr-star-lit { color: rgb(255, 214, 90); font-size: 44px; }
.rr-star-dim { color: rgba(255, 255, 255, 0.25); font-size: 44px; }
.rr-lap { flex-direction: row; justify-content: space-between; min-width: 420px; }
.rr-lap > Label { white-space: nowrap; }
.rr-lap-best, .rr-lap-best > Label { color: rgb(157, 255, 143); }
#rr-best { margin-top: 8px; }
