/* Sizes target the 1080x1920 reference. Pointer picking is not a USS property in Unity 6: HudController sets
   PickingMode.Ignore on everything except buttons and overlays so touch reaches steering. */
* {
    color: rgb(255, 255, 255);
    font-size: 26px;
    white-space: normal;
}

#hud {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.row { flex-direction: row; flex-wrap: nowrap; }
.row > Label { white-space: nowrap; }
.big { font-size: 40px; -unity-font-style: bold; }
.dim, .dim > Label { color: rgb(184, 188, 196); }

.panel {
    background-color: rgba(10, 12, 16, 0.55);
    border-radius: 12px;
    padding: 10px 14px;
}

#hud-left { position: absolute; left: 2%; top: 2%; align-items: flex-start; }
#hud-right { position: absolute; right: 2%; top: 2%; align-items: flex-end; }
#mini {
    width: 156px; height: 134px; margin-top: 10px;
    background-color: rgba(10, 12, 16, 0.55);
    border-radius: 8px;
}
#controls { position: absolute; left: 2%; bottom: 14%; }
#lapCounter { margin-top: 8px; font-size: 72px; }
#lapCounter > Label { font-size: 72px; -unity-font-style: bold; }

#combo { position: absolute; left: 0; right: 0; top: 18%; -unity-text-align: middle-center; font-size: 44px; -unity-font-style: bold; opacity: 0; }
#flash { position: absolute; left: 0; right: 0; top: 28%; -unity-text-align: middle-center; font-size: 44px; -unity-font-style: bold; opacity: 0; }
#count { position: absolute; left: 0; right: 0; top: 38%; -unity-text-align: middle-center; font-size: 240px; -unity-font-style: bold; opacity: 0; }
#hint {
    position: absolute; left: 6%; right: 6%; bottom: 4%;
    -unity-text-align: middle-center;
    background-color: rgba(10, 12, 16, 0.55);
    border-radius: 12px;
    padding: 10px 14px;
}

.btn {
    background-color: rgba(10, 12, 16, 0.7);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 12px;
    padding: 12px 22px;
    font-size: 30px;
}
.btn:hover { background-color: rgba(60, 64, 74, 0.85); }
.btn.wide { min-width: 460px; margin-top: 14px; }
#pauseBtn { position: absolute; left: 50%; top: 2%; translate: -50% 0; min-width: 84px; font-size: 36px; }

.overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.62);
}
.card {
    align-items: center;
    background-color: rgba(18, 20, 26, 0.92);
    border-radius: 16px;
    padding: 24px 32px;
    max-width: 94%;
}
.ov-title { font-size: 64px; -unity-font-style: bold; -unity-text-align: middle-center; }
.ov-sub { font-size: 30px; color: rgb(184, 188, 196); margin-top: 8px; }

#rr-score, #rr-tires, #rr-achievements, #rr-laps { align-items: center; margin-top: 10px; }
.rr-label { color: rgb(184, 188, 196); }
.rr-pps { font-size: 48px; -unity-font-style: bold; }
.rr-badge { color: rgb(255, 214, 90); -unity-font-style: bold; }
.rr-star-lit { color: rgb(255, 214, 90); font-size: 44px; }
.rr-star-dim { color: rgba(255, 255, 255, 0.25); font-size: 44px; }
.rr-lap { flex-direction: row; justify-content: space-between; min-width: 420px; }
.rr-lap > Label { white-space: nowrap; }
.rr-lap-best, .rr-lap-best > Label { color: rgb(157, 255, 143); }
#rr-best { margin-top: 8px; }
